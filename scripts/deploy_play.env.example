# Copy this file to scripts/deploy_play.env (which is gitignored) and fill it in.
#
#   cp scripts/deploy_play.env.example scripts/deploy_play.env
#
# PLAY_JSON_KEY — path to the Google Play service-account JSON key.
#   Keep it OUTSIDE this repo so it can never be committed.
#   Get it from: Google Cloud Console -> Service Accounts -> Keys -> Add key -> JSON,
#   then grant that service account release access in Play Console ->
#   Users and permissions.
PLAY_JSON_KEY=~/.config/play/play-service-account.json

# PLAY_PACKAGE — optional. Auto-detected from android/app/build.gradle.kts
#   (education.internut.calvinchesstrainer). Only set to override.
# PLAY_PACKAGE=education.internut.calvinchesstrainer
