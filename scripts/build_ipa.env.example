# Copy to scripts/build_ipa.env (gitignored) and fill in:
#
#   cp scripts/build_ipa.env.example scripts/build_ipa.env
#
# Both values are on App Store Connect -> Users and Access -> Integrations ->
# App Store Connect API (Team Keys tab).

# The key's "Key ID" column. The script looks for AuthKey_<ASC_KEY_ID>.p8 in
# ~/.appstoreconnect/private_keys/ (also ~/private_keys/, ~/.private_keys/).
ASC_KEY_ID=XXXXXXXXXX

# The "Issuer ID" shown above the key list (a UUID).
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000

# Optional: a key kept somewhere else.
# ASC_KEY_FILE=~/somewhere/AuthKey_XXXXXXXXXX.p8
