{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "calvin-chess-trainer",
          "appId": "1:522968736205:android:c103c5a3903aaa35bc2484",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "calvin-chess-trainer",
          "appId": "1:522968736205:ios:22715df195c09ba4bc2484",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "calvin-chess-trainer",
          "configurations": {
            "android": "1:522968736205:android:c103c5a3903aaa35bc2484",
            "ios": "1:522968736205:ios:22715df195c09ba4bc2484",
            "web": "1:522968736205:web:ddd406dcf5be69cebc2484"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.map"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/stockfish/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
